# ─── Application ───
APP_NAME=CineMatch AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_PREFIX=/api/v1

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://cinematch:cinematch_secret@localhost:5432/cinematch_db

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ───
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── TMDB API ───
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=60

# ─── CORS ───
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000","http://localhost:5173"]

# ─── ML Models ───
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index.bin
TFIDF_MATRIX_PATH=./data/tfidf_matrix.pkl
SIMILARITY_MATRIX_PATH=./data/similarity_matrix.pkl

# ─── Enterprise API Keys ───
ENTERPRISE_API_KEY=your-enterprise-api-key
