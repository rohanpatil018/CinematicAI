# ──────────────────────────────────────────────────────
# CineMatch AI — Docker Environment Configuration
# Copy this to .env and update values for production
# ──────────────────────────────────────────────────────

# ─── Application ───
APP_NAME=CineMatch AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
API_PREFIX=/api/v1

# ─── Database (Docker internal network) ───
DATABASE_URL=postgresql+asyncpg://cinematch:cinematch_secret@postgres:5432/cinematch_db
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch_secret
POSTGRES_DB=cinematch_db

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── JWT Auth ───
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── TMDB API ───
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=60

# ─── CORS (allow the nginx proxy) ───
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000"]

# ─── ML Models ───
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index.bin
TFIDF_MATRIX_PATH=./data/tfidf_matrix.pkl
SIMILARITY_MATRIX_PATH=./data/similarity_matrix.pkl

# ─── Enterprise API Keys ───
ENTERPRISE_API_KEY=your-enterprise-api-key
